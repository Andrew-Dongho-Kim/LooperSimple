<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Notification.LoopTitle" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:textAppearance">@style/TextAppearance.Compat.Notification.Title</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Notification.Time" parent="TextAppearance.Compat.Notification.Title">
        <item name="android:textAppearance">@style/TextAppearance.Compat.Notification.Title</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Notification.Detail" parent="TextAppearance.Compat.Notification.Info">
        <item name="android:textAppearance">@style/TextAppearance.Compat.Notification.Info</item>
        <item name="android:textSize">12sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="Notification.Progress" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/notification_progress</item>
        <item name="android:progressTint">@color/notification_accent</item>
        <item name="android:progressBackgroundTint">@color/notification_track</item>
        <item name="android:indeterminate">false</item>
        <item name="android:max">100</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>